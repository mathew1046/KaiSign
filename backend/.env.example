KIOSK_MODEL_PATH=backend/runtime_assets/logistic_sign_classifier.npz
KIOSK_HAND_LANDMARKER_PATH=../wlasl_signs_model/hand_landmarker.task
KIOSK_MIN_PROBABILITY=0.85
KIOSK_BUFFER_SECONDS=2
KIOSK_MIN_DETECTED_FRAMES=5
KIOSK_CLIP_MIN_FRAMES=8
KIOSK_CLIP_MAX_FRAMES=12
KIOSK_MAX_INFERENCE_SESSIONS=1
KIOSK_INFERENCE_SESSION_TTL_SECONDS=120
KIOSK_INFERENCE_FRAME_INTERVAL_MS=200
KIOSK_MIN_HAND_DETECTION_CONFIDENCE=0.35
KIOSK_MIN_TRACKING_CONFIDENCE=0.35
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# fallback, if your project names it this way:
SUPABASE_SECRET_KEY=

# Server-only Gemini Live settings. Never expose GEMINI_API_KEY to browser code.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_LANGUAGE=en-US
GEMINI_LIVE_MAX_SESSIONS=1
ESP_AUDIO_STREAM_URL=http://172.16.162.9/stream
